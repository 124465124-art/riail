# Copy this file to .env. .env is in .gitignore: never commit it.
# It runs as-is with the mock AI; add a key and set RIAIL_ANSWERER=llm for real AI answers.

# Which AI answers questions: mock (fixed answers, no key needed; the default),
# llm (real Groq call), or mock_fail (simulates the AI being down, to show the fallback)
RIAIL_ANSWERER=mock

# Free key from https://console.groq.com/keys
RIAIL_LLM_API_KEY=
RIAIL_LLM_MODEL=openai/gpt-oss-20b
RIAIL_LLM_BASE_URL=https://api.groq.com/openai/v1
RIAIL_LLM_TIMEOUT=15

# How rules are matched: local (AI embedding model, downloads ~80 MB once)
# or keyword (word matching, no download; also the D1 comparison baseline)
RIAIL_EMBEDDER=local

# Rules scoring below this (0 to 1) are ignored; if none pass, the answer is "not covered".
# Re-run python -m riail.ingestion.load_rules after changing RIAIL_EMBEDDER.
RIAIL_MIN_SCORE=0.3
RIAIL_MAX_RESULTS=4
